.taku-area {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    position: relative;
    margin-top: 20px;
}

.taku-robot {
    width: 120px;
    height: 140px;
    position: relative;
    animation: float 3s ease-in-out infinite;
    cursor: pointer;
    transition: transform 0.2s;
}

.taku-robot:active {
    transform: scale(0.95);
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

/* 天线 */
.taku-antenna {
    width: 4px;
    height: 25px;
    background: var(--text-color);
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 2px;
}
.taku-antenna::after {
    content: '';
    width: 12px;
    height: 12px;
    background: var(--secondary-color);
    border: var(--comic-border);
    border-radius: 50%;
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 10px var(--secondary-color);
}

/* 头部 */
.taku-head {
    width: 100px;
    height: 70px;
    background: #fff;
    border: var(--comic-border);
    border-radius: 20px 20px 10px 10px;
    position: absolute;
    top: 20px;
    left: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    box-shadow: var(--comic-shadow);
    z-index: 2;
}

/* 发光眼睛 */
.taku-eye {
    width: 20px;
    height: 20px;
    background: var(--primary-color);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--primary-color);
    transition: all 0.3s;
}
.taku-eye.left { animation: blink 4s infinite; }
.taku-eye.right { animation: blink 4s infinite 0.2s; }

@keyframes blink {
    0%, 90%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
}

/* 塔库情绪变化 */
.taku-robot.happy .taku-eye { background: #feca57; box-shadow: 0 0 15px #feca57; }
.taku-robot.confused .taku-eye { background: #ff6b6b; box-shadow: 0 0 15px #ff6b6b; transform: rotate(45deg); border-radius: 5px;}

/* 身体（数据流核心） */
.taku-body {
    width: 80px;
    height: 60px;
    background: #e0f7fa;
    border: var(--comic-border);
    border-radius: 10px 10px 20px 20px;
    position: absolute;
    top: 80px;
    left: 20px;
    box-shadow: var(--comic-shadow);
    overflow: hidden;
}

/* 数据流动画 */
.data-stream {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 10px,
        var(--primary-color) 10px,
        var(--primary-color) 12px
    );
    opacity: 0.4;
    animation: scrollData 2s linear infinite;
}

@keyframes scrollData {
    0% { transform: translateY(-20px); }
    100% { transform: translateY(0); }
}

/* 对话框 */
.taku-dialog-box {
    background: #fff;
    border: var(--comic-border);
    border-radius: 20px;
    padding: 20px;
    max-width: 450px;
    position: relative;
    box-shadow: var(--comic-shadow);
    margin-bottom: 30px;
    transition: transform 0.2s;
}

.taku-dialog-box::before {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 30px;
    width: 0;
    height: 0;
    border-top: 15px solid #2d3436;
    border-right: 15px solid transparent;
    border-left: 15px solid transparent;
}

.taku-dialog-box::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 33px;
    width: 0;
    height: 0;
    border-top: 12px solid #fff;
    border-right: 12px solid transparent;
    border-left: 12px solid transparent;
}

#taku-text {
    font-size: 16px;
    line-height: 1.6;
    font-weight: bold;
}
/* ================= 塔库悬空布局 ================= */
.taku-area {
    position: fixed;
    bottom: 20px;
    left: 20px;
    display: flex;
    align-items: flex-end;
    gap: 20px;
    z-index: 1000;
    pointer-events: none; /* 让鼠标穿透空白区域 */

    /* === 新增：拖拽相关样式 === */
    cursor: grab;
    user-select: none; /* 防止拖拽时选中文字 */
    touch-action: none; /* 防止移动端拖拽时触发页面滚动 */
}

/* 拖拽时变更光标 */
.taku-area.dragging {
    cursor: grabbing;
    transition: none !important; /* 拖拽时取消过渡动画，防止卡顿 */
}

/* 恢复原有的 pointer-events */
.taku-robot { pointer-events: auto; }
.taku-dialog-box { pointer-events: auto; }
